  firstvar = 4,
  lastvar = 15,
  product_knowledge = "known",
  drop.negative = TRUE,
  generate = FALSE
)
nail_evidence(perfume_preview)
cat(substr(nail_prompt(perfume_preview, print = FALSE), 1, 700), "\n")

## 6. Melons: no artificial Session factor
